AWS_ACCESS_KEY_ID="op://Private/AWS Access Key - S3 - Personal/access key id"
AWS_SECRET_ACCESS_KEY="op://Private/AWS Access Key - S3 - Personal/secret access key"
# ansible:run's inventory source, ansible/netbox_inventory.yml -- a
# read-only token, deliberately separate from any write-scoped NetBox
# token (this repo's roles do their own writes via
# community.general.onepassword lookups in-task, not via this var).
NETBOX_TOKEN="op://nas-overlay/netbox-ansible-inventory-token/token"

# Ansible-only credential set for the scheduled reconciliation workflow
# (.github/workflows/ansible-reconcile.yml), resolved via 1Password Connect
# on nas-sdg rather than the desktop-app session `task ansible:run` uses.
#
# Deliberately NOT the same as the repo-root .env: Connect is scoped
# read-only to the nas-overlay vault, so it can't resolve root .env's
# op://Private/... AWS keys at all -- pulling in unrelated vars here would
# just break resolution for something this workflow never needed.
#
# The UDM credentials themselves are looked up in-role, not via this file
# (see unifi_network_*'s onepassword lookups) -- their default vault
# (Automation) isn't in Connect's scope either, so the workflow overrides
# each role's *_creds_op_vault to nas-overlay, where a duplicate of the
# same item lives for CI's sake.
NETBOX_TOKEN="op://nas-overlay/netbox-ansible-inventory-token/token"
